CRATE_DATABASE_URL=postgresql+asyncpg://crate:crate_dev_password@localhost:5432/crate
CRATE_ENVIRONMENT=development

# Generate a real value with: python -c "import secrets; print(secrets.token_urlsafe(32))"
CRATE_AUTH_SECRET=insecure-dev-secret-change-me-before-deploying-anywhere
CRATE_ACCESS_TOKEN_LIFETIME_SECONDS=3600
# Set true once served over HTTPS so the auth cookie requires it.
CRATE_COOKIE_SECURE=false
CRATE_ALLOWED_ORIGINS=["http://localhost:3000"]
