# OS
.DS_Store

# Python (backend, pipelines, models)
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/

# Built recommender models (rebuild with scripts/build_tfidf_model.py)
/models/*.joblib
/models/*.tmp
# Earlier catalogs' models, kept to compare against after a catalog batch
/models/archive/

# Terraform (infrastructure)
.terraform/
*.tfstate
*.tfstate.*

# Environment
.env
.env.*
!.env.example

# Evaluation working files: pool.jsonl is rebuilt with python -m crate_backend.evaluation.pool;
# judgments.jsonl holds the owner's hand grades and stays local
/eval/pool.jsonl
/eval/judgments.jsonl
/eval/scenes/pool.jsonl
/eval/scenes/judgments.jsonl

# Personal notes (not for the repo)
/docs/project-decisions.md

# MusicBrainz database dumps (large, downloaded locally)
/MusicBrainz/

# Run logs
*.log

# Database backups taken before each catalog batch ingest
/backups/
